{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "strict": true,
    "jsx": "preserve",
    "importHelpers": true,
    "moduleResolution": "bundler",
    "allowJs": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "noImplicitReturns": true,
    "noImplicitOverride": true,
    "useDefineForClassFields": true,
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "noEmit": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "experimentalDecorators": true,
    "resolveJsonModule": true,
    "types": ["node", "chrome"],
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "paths": {
      "~/*": ["./src/*"],
      "@/*": ["./src/entries/*"],
      "@ptd/*": ["./src/packages/*"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.d.ts",
    "src/**/*.tsx",
    "src/**/*.vue",
    "tests/**/*.ts",
    "tests/**/*.mts",
    "vitest.config.ts"
  ],
  // 注意：`tests/i18n/generateWebextLocales.test.ts`、`tests/i18n/telegramMarkdown.test.ts`、
  // `tests/entries/content-script/warManifest.test.ts` 会 import `vite/**`（属于 tsconfig.node 的
  // composite project），主项目引用其源文件会触发 TS6305（未构建的 project reference 输出）。
  // 这类跨 project 的 import 在对应测试里用**精确的** `// @ts-expect-error TS6305` 逐行豁免，
  // 而不是把测试整体排除出类型检查（task-12 方案 B：把测试并入 tsconfig.node.json 不可行 ——
  // 两边同时包含会让该 directive 在 check:node 里变成 TS2578 unused，故回退到行级豁免）。
  "exclude": ["src/entries/options/harness.ts"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
